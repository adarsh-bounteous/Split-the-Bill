  "color-surface": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9608, 0.9686, 0.9804], "hex": "#f5f7fa"}, "$description": "Raised or secondary surface"},
  "color-surface-strong": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.8941, 0.9059, 0.9216], "hex": "#e4e7eb"}, "$description": "Skeletons and pressed surfaces"},
  "color-primary": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0588, 0.4627, 0.4314], "hex": "#0f766e"}, "$description": "Brand and primary actions"},
