{
  "color-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1216, 0.1608, 0.2], "hex": "#1f2933"}, "$description": "Primary text"},
  "color-fg-muted": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.3216, 0.3765, 0.4275], "hex": "#52606d"}, "$description": "Secondary text and hints"},
