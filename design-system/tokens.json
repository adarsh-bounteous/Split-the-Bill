  "color-danger": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.7255, 0.1098, 0.1098], "hex": "#b91c1c"}, "$description": "Destructive actions, errors, money you owe"},
  "color-danger-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9961, 0.949, 0.949], "hex": "#fef2f2"}, "$description": "Danger tint"},
  "color-success": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0863, 0.396, 0.2039], "hex": "#166534"}, "$description": "Success, money you are owed"},
  "color-success-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9412, 0.9922, 0.9569], "hex": "#f0fdf4"}, "$description": "Success tint"},
  "color-warning": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.5725, 0.251, 0.0549], "hex": "#92400e"}, "$description": "Warning"},
  "color-warning-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 0.9843, 0.9216], "hex": "#fffbeb"}, "$description": "Warning tint"},
  "color-info": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1d4ed8"}, "$description": "Info"},
